generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COORDENADOR
  ESTUDANTE
  PROFESSOR
  RESPONSAVEL
  VISITANTE
}

enum Period {
  MANHA
  TARDE
  NOITE
}

enum EnrollmentStatus {
  ACTIVE
  APPROVED
  DROPPED
  PENDENT
  FAILED
}

model User {
  id String @id @default(uuid())

  name       String
  email      String   @unique
  password   String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  memberships Membership[]

  @@map("users")
}

model Organization {
  id String @id @default(uuid())

  name       String
  slug       String   @unique
  created_at DateTime @default(now())

  members       Membership[]
  classes       Class[]
  teachers      Teacher[]
  students      Student[]
  announcements Announcement[]
  disciplines   Discipline[]

  @@map("organizations")
}

model Membership {
  id String @id @default(uuid())

  role   Role   @default(VISITANTE)
  user   User   @relation(fields: [userId], references: [id])
  userId String

  teacherProfile Teacher?     @relation(fields: [teacherId], references: [id])
  teacherId      String?      @unique
  studentProfile Student?     @relation(fields: [studentId], references: [id])
  studentId      String?      @unique

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt



  @@unique([userId, organizationId])
  @@map("memberships")
}

model Class {
  id String @id @default(uuid())

  name      String
  year      Int
  period    Period
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  assignments   TeacherAssignment[]
  enrollments   Enrollment[]
  announcements Announcement[]

  @@map("classes")
}

model Teacher {
  id          String              @id @default(uuid())
  userId      String              @unique
  assignments TeacherAssignment[]

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  membership Membership?

  @@map("teachers")
}

model Student {
  id String @id @default(uuid())

  userId String @unique

  ra          String
  dateOfBirth DateTime

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  membership Membership?

  enrollments Enrollment[]

  @@map("students")
}

model Discipline {
  id String @id @default(uuid())

  name        String
  description String

  assignments TeacherAssignment[]

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  @@map("disciplines")
}

model TeacherAssignment {
  id String @id @default(uuid())

  workload Int

  classId      String
  teacherId    String
  disciplineId String

  class      Class      @relation(fields: [classId], references: [id])
  teacher    Teacher    @relation(fields: [teacherId], references: [id])
  discipline Discipline @relation(fields: [disciplineId], references: [id])

  @@unique([classId, teacherId, disciplineId])
  @@map("teacher_assignments")
}

model Enrollment {
  id String @id @default(uuid())

  year           Int
  status         EnrollmentStatus
  enrollmentDate DateTime

  studentId String
  classId   String

  student Student @relation(fields: [studentId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])

  @@unique([studentId, classId])
  @@map("enrollments")
}

model Announcement {
  id String @id @default(uuid())

  title     String
  content   String
  createdAt DateTime @default(now())
  priority  String
  expiresAt DateTime

  authorId String

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  classId String?
  class   Class?  @relation(fields: [classId], references: [id])

  @@map("announcements")
}
